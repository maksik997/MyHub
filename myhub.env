# Spring boot configuration
SPRING_PROFILES_ACTIVE=prod # active profile
PORT=8180 # application port

# File management
MYHUB_MAX_FILE_SIZE=20GB

# MyHub specific configuration
MYHUB_GAME_DIRECTORY=./games # directory with games
MYHUB_MEDIA_DIRECTORY=./media # directory with media

# Database config
DB_DATA=./db # directory containing the database data
DB_USER=myhub
DB_PASSWORD=super#Secret2Password
DB_PORT=5432
